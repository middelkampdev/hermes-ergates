.DS_Store
**/.DS_Store

# Local generated previews and temporary work products
/work/

# Local agent workspaces and Python virtualenvs
.superpowers/
integrations/ergates/.venv/
**/__pycache__/
**/.pytest_cache/

# Python build and coverage output
**/.venv/
**/*.egg-info/
**/.coverage
**/coverage.xml
**/htmlcov/

# The plugin tests' lock file. `uv run` writes it when it is missing or stale;
# committed, it would record the plugin version, which .gflow/set-version.sh
# does not write.
integrations/ergates-tests/uv.lock

# Mobile coverage output
apps/mobile/coverage/

# Pinned Hermes source for the contract tests (scripts/ci-local.sh)
/.cache/

# Real environment files and signing material; *.env.example stays committed
.env
*.env
*.p8
*.p12
*.key
*.jks
*.mobileprovision

# Design and plan documents stay local; not part of the public repository.
docs/superpowers/

# Personal research notes stay local; not part of the public repository.
docs/research/
