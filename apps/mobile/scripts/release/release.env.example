# Copy this file to apps/mobile/.release/release.env (git-ignored, chmod 600)
# and fill it in. RELEASING.md says where each value comes from.
# Wrap passwords in single quotes, for example ANDROID_UPLOAD_KEY_PASSWORD='p@ss$w0rd'.
# RELEASING.md's Mac build steps load this file with the shell, which expands
# an unquoted `$`, backtick or `\`; upload-secrets.sh (secrets.mjs's
# parseEnvFile) reads it literally. Single quotes make both readers agree.
# Put these files next to it:
#   ios-distribution.p12            Apple Distribution certificate with its private key
#   ios-appstore.mobileprovision    App Store provisioning profile for com.nousresearch.hermesergates
#   asc-api-key.p8                  App Store Connect API key (App Manager role)
#   android-upload.jks              Android upload keystore (make-upload-keystore.sh creates it)
#   play-service-account.json       Google Play service account key

# Apple. The team ID and the key IDs are identifiers; the .p12 password is secret.
APPLE_TEAM_ID=                     # 10 characters: developer.apple.com > Account > Membership details
IOS_DIST_CERT_PASSWORD=            # the password you gave the .p12 export
APP_STORE_CONNECT_KEY_ID=          # App Store Connect > Users and Access > Integrations > the key's Key ID
APP_STORE_CONNECT_ISSUER_ID=       # same page, the Issuer ID above the key list

# Android upload key. make-upload-keystore.sh creates a PKCS12 keystore, which has
# one password: use the same value for both passwords, at least 6 characters.
ANDROID_UPLOAD_KEY_ALIAS=upload
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
ANDROID_UPLOAD_KEY_PASSWORD=
