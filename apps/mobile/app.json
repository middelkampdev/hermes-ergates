{
  "expo": {
    "name": "Ergates",
    "slug": "ergates",
    "version": "0.1.0",
    "scheme": "ergates",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "dev.middelkamp.ergates",
      "deploymentTarget": "16.4",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/android-icon.png",
      "package": "dev.middelkamp.ergates",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0d1117"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ergates attaches photos you choose to a chat with your assistant."
        }
      ],
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ergates uses the microphone for voice input in the composer.",
          "speechRecognitionPermission": "Ergates turns your voice into text for the composer. On-device recognition is used when available."
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-scene-lifecycle",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
