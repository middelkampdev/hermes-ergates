{
  "expo": {
    "name": "Ergates",
    "slug": "ergates",
    "version": "0.1.0",
    "scheme": "ergates",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "dev.middelkamp.ergates",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.middelkamp.ergates",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ergates attaches photos you choose to a chat with your assistant."
        }
      ],
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ergates uses the microphone for voice input in the composer.",
          "speechRecognitionPermission": "Ergates turns your voice into text for the composer. On-device recognition is used when available."
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
